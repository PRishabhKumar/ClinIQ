generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DB_CONNECTION_STRING")
}

enum Role {
  PATIENT
  DOCTOR
  ADMIN
}

enum AppointmentStatus {
  HELD
  BOOKED
  CANCELLED
  COMPLETED
  LEAVE_CANCELLED
}

enum Urgency {
  LOW
  MEDIUM
  HIGH
}

model User {
  id                 String   @id @default(uuid())
  email              String   @unique
  passwordHash       String?
  googleId           String?  @unique
  googleRefreshToken String?
  role               Role
  name               String
  phone              String?
  createdAt          DateTime @default(now())

  doctorProfile DoctorProfile?
  patientAppointments Appointment[] @relation("PatientAppointments")
}

model DoctorProfile {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id])
  specializations String[]
  slotDurationMin Int
  workingHours    WorkingHour[]
  leaveDays       LeaveDay[]
  appointments    Appointment[] @relation("DoctorAppointments")
}

model WorkingHour {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  weekday     Int
  startTime   String
  endTime     String
}

model LeaveDay {
  id          String   @id @default(uuid())
  doctorId    String
  doctor      DoctorProfile @relation(fields: [doctorId], references: [id])
  date        DateTime   @db.Date
  reason      String?
  createdAt   DateTime @default(now())
}

model Appointment {
  id               String   @id @default(uuid())
  patientId        String
  patient          User     @relation("PatientAppointments", fields: [patientId], references: [id])
  doctorId         String
  doctor           DoctorProfile @relation("DoctorAppointments", fields: [doctorId], references: [id])
  slotStart        DateTime
  slotEnd          DateTime
  status           AppointmentStatus @default(HELD)
  holdExpiresAt    DateTime?
  createdAt        DateTime @default(now())

  @@index([doctorId, slotStart])

  symptomForm      SymptomForm?
  preVisitSummary  PreVisitSummary?
  postVisitSummary PostVisitSummary?
  googleEventId         String?  // Doctor's calendar event ID
  patientGoogleEventId  String?  // Patient's calendar event ID
}

model SymptomForm {
  id             String   @id @default(uuid())
  appointmentId  String   @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  rawText        String
  durationDays   Int?
  severity       String?
  submittedAt    DateTime @default(now())
}

model PreVisitSummary {
  id             String   @id @default(uuid())
  appointmentId  String   @unique
  appointment    Appointment @relation(fields: [appointmentId], references: [id])
  urgency        Urgency?
  chiefComplaint String?
  suggestedQuestions String[]
  status         String    // "OK" | "FAILED" | "PENDING_RETRY"
  rawLlmResponse Json?
  generatedAt    DateTime?
}

model NotificationLog {
  id            String   @id @default(uuid())
  appointmentId String
  type          String   // "BOOKING_CONFIRMATION", "CANCELLATION", "LEAVE_CONFLICT", "REMINDER"
  status        String   // "PENDING", "SENT", "FAILED"
  attempts      Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model PostVisitSummary {
  id                 String   @id @default(uuid())
  appointmentId      String   @unique
  appointment        Appointment @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  clinicalNotes      String
  patientSummary     String?
  medicationSchedule String?
  followUpSteps      String?
  rawLlmResponse     Json?
  generatedAt        DateTime?
}
